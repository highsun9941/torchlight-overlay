<Window x:Class="Tartarus.App.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="토치라이트 오버레이" Width="660" Height="900" MinWidth="620" MinHeight="640"
        Topmost="False" ResizeMode="CanResize" FontFamily="Malgun Gothic" FontSize="13"
        Background="#101722" Foreground="#E8E8EC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="#253348" />
      <Setter Property="Foreground" Value="#F4F7FC" />
      <Setter Property="BorderBrush" Value="#42536C" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8EC" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#E8EEF6" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA0AC" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style x:Key="LabelBox" TargetType="TextBox">
      <Setter Property="Margin" Value="4,1,10,1" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="22,12" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#A8B9CE" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="#172130" BorderBrush="#304058" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabBorder" Property="Background" Value="#25443F" />
          <Setter TargetName="TabBorder" Property="BorderBrush" Value="#60C8AF" />
          <Setter Property="Foreground" Value="#F3FFF9" />
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E8EEF6" /><Setter Property="Background" Value="#253348" /><Setter Property="Padding" Value="10,8" />
      <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A5B70" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,7" /><Setter Property="MinHeight" Value="36" /><Setter Property="Foreground" Value="#E8EEF6" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#253348" BorderBrush="#42536C" BorderThickness="1" CornerRadius="4" /></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="10,7,28,7" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
          <TextBlock Text="v" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="#83E0C8" IsHitTestVisible="False" />
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#253348" BorderBrush="#42536C" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="320"><ItemsPresenter /></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="TORCHLIGHT / COMPANION" Foreground="#7FDBC6" FontSize="11" FontWeight="Bold" />
      <TextBlock Text="토치라이트 오버레이" FontSize="26" FontWeight="Bold" Margin="0,7,0,6" />
      <DockPanel Margin="0,16,0,0">
        <TextBlock Text="게임 언어" Margin="0,0,12,0" />
        <ComboBox x:Name="LanguageCombo" Width="155" HorizontalAlignment="Left" SelectionChanged="CompanionSetting_Changed">
          <ComboBoxItem Content="한국어"/><ComboBoxItem Content="English"/>
        </ComboBox>
      </DockPanel>
      <CheckBox x:Name="AutoContentCheck" Content="콘텐츠 자동 감지" Margin="0,12,0,0" Checked="AutoContent_Changed" Unchecked="AutoContent_Changed"
                ToolTip="게임 로그에서 콘텐츠를 감지해 자동으로 전환합니다. 끄면 탭으로 직접 선택합니다." />
      <TextBlock x:Name="ContentStatus" Text="자동 감지 대기" Foreground="#83E0C8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,14,0,0" Text="추천 표시는 클릭을 통과합니다. 선택과 확인은 직접 진행하세요." Foreground="#97A9BF" FontSize="11" TextWrapping="Wrap" />
    <TabControl x:Name="ModeTabs" Background="#172130" BorderBrush="#304058" SelectionChanged="ModeTabs_SelectionChanged">
      <TabItem Header="타르타로스">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="18">
    <!-- Target window and capture -->
    <TextBlock Style="{StaticResource Section}" Margin="0,0,0,4" Text="게임 연결" />
    <DockPanel>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="새로고침" ToolTip="실행 중인 창 목록 새로고침" Click="RefreshButton_Click" />
      <ComboBox x:Name="WindowCombo" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="CaptureButton" Content="게임 연결" Click="CaptureButton_Click" />
      <CheckBox x:Name="AutoAttachCheck" Content="게임 자동 연결" IsChecked="True" />
    </StackPanel>
    <TextBlock x:Name="CaptureStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="게임 창 연결 대기" />

    <!-- Scanning -->
    <TextBlock Style="{StaticResource Section}" Text="화면 인식" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="ScanButton" Content="지금 인식" Click="ScanButton_Click" />
      <CheckBox x:Name="AutoScanCheck" Content="자동" Margin="0,0,4,0" Checked="AutoScanCheck_Changed" Unchecked="AutoScanCheck_Changed" />
      <Slider x:Name="IntervalSlider" Width="140" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.1" TickPlacement="BottomRight"
              ValueChanged="IntervalSlider_ValueChanged" ToolTip="인식 시작 간격. 0초이면 이전 계산이 끝난 직후 다시 인식합니다." />
      <TextBlock x:Name="IntervalText" Margin="6,0,0,0" Text="0.5 s" />
    </StackPanel>
    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Margin="0,6,0,0">
      <CheckBox x:Name="OverlayCheck" Content="오버레이" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
      <CheckBox x:Name="BoxesCheck" Content="인식 영역" ToolTip="격자, 카드, 버튼, 형구와 찬란 슬롯의 인식 영역을 표시합니다." Checked="BoxesCheck_Changed" Unchecked="BoxesCheck_Changed" />
      <CheckBox x:Name="TextCheck" Content="인식 텍스트" ToolTip="문자 인식 영역과 읽은 내용을 오버레이에 표시합니다." Checked="TextCheck_Changed" Unchecked="TextCheck_Changed" />
    </StackPanel>
    <TextBlock x:Name="ScanStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Move hints -->
    <StackPanel>
      <TextBlock Style="{StaticResource Section}" Text="추천 정확도" />
      <StackPanel x:Name="HintChecks" Orientation="Horizontal">
        <CheckBox x:Name="HintsCheck" Content="추천 표시" Checked="HintsCheck_Changed" Unchecked="HintsCheck_Changed" />
        <CheckBox x:Name="HintsOnlyCheck" Content="추천만 표시" Margin="12,0,12,0" Checked="HintsOnlyCheck_Changed" Unchecked="HintsOnlyCheck_Changed" ToolTip="추천 테두리와 설명만 표시합니다." />
        <CheckBox x:Name="HideAlternativesCheck" Content="최선의 선택만 표시" ToolTip="끄면 비슷한 기대값의 대안도 점선으로 표시합니다." Checked="HideAlternativesCheck_Changed" Unchecked="HideAlternativesCheck_Changed" />
      </StackPanel>
      <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Left" Text="빠르게" Foreground="#9AA0AC" Margin="0,0,6,0" />
        <TextBlock DockPanel.Dock="Right" Text="정밀하게" Foreground="#9AA0AC" Margin="6,0,0,0" />
        <Slider x:Name="HintSlider" Minimum="0" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="HintSlider_ValueChanged" ToolTip="선택지당 탐색 횟수. 정밀 모드일수록 계산 시간이 늘어납니다." />
      </DockPanel>
      <TextBlock x:Name="HintLevelText" Margin="0,2,0,0" TextWrapping="Wrap" Text="—" />
      <TextBlock x:Name="HintStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />
    </StackPanel>

    <!-- The game's log -->
    <TextBlock Style="{StaticResource Section}" Text="게임 로그" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="PickLogButton" Content="직접 선택" ToolTip="게임 폴더의 UE_game\TorchLight\Saved\Logs\UE_game.log를 선택하세요." Click="PickLogButton_Click" />
      <Button x:Name="AutoLogButton" Content="자동" ToolTip="실행 중인 게임, Steam 라이브러리와 런처 설정에서 로그를 찾습니다." Click="AutoLogButton_Click" />
    </StackPanel>
    <TextBlock x:Name="LogStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Statistics -->
    <TextBlock Style="{StaticResource Section}" Text="완주 기록" />
    <DockPanel>
      <Button x:Name="ResetStatsButton" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Content="초기화" ToolTip="완주 기록 초기화" Click="ResetStatsButton_Click" />
      <TextBlock x:Name="StatsText" TextWrapping="Wrap" Text="—" />
    </DockPanel>

    <!-- Debugging (the command line's debug flag): labels, dataset, what was read, the log -->
    <StackPanel x:Name="DebugPanel">
      <TextBlock Style="{StaticResource Section}" Text="인식 데이터 수정" />
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="EditCheck" Content="수정 모드" Checked="EditCheck_Changed" Unchecked="EditCheck_Changed" />
        <Button x:Name="SaveButton" Content="화면 저장" Click="SaveButton_Click" />
        <CheckBox x:Name="AutoCollectCheck" Content="자동 수집" Margin="6,0,0,0" ToolTip="Save a frame to the dataset whenever the Sandbox read changes (with auto scan)" Checked="AutoCollectCheck_Changed" Unchecked="AutoCollectCheck_Changed" />
      </StackPanel>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="간수" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WardenBox" Style="{StaticResource LabelBox}" ToolTip="The Warden's cell, 1-16" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="남은 일수" />
        <TextBox Grid.Row="0" Grid.Column="3" x:Name="DaysBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="목적지" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DestinationsBox" Style="{StaticResource LabelBox}" ToolTip="Cells on the Destination cards, left to right: 9,11,12" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="찬란" />
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ChromaticBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="형구" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="InstrumentsBox" Style="{StaticResource LabelBox}" ToolTip="ids, comma-separated: ironbox,muzzle" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="ApplyLabelsButton" Content="수정 적용" Click="ApplyLabelsButton_Click" />
        <Button x:Name="ResetLabelsButton" Content="수정 취소" Click="ResetLabelsButton_Click" />
        <Button x:Name="OpenDatasetButton" Content="데이터 폴더" Click="OpenDatasetButton_Click" />
      </StackPanel>
      <TextBlock x:Name="DatasetStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" Foreground="#6F7580" TextWrapping="Wrap"
                 Text="In edit mode click a cell on the overlay: a menu of Code, rarity and flags. Auto scan pauses while editing." />

      <!-- Sandbox summary and log -->
      <TextBlock Style="{StaticResource Section}" Text="보드 상태" />
      <TextBox x:Name="SandboxSummary" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
               Background="#15161A" Foreground="#D8D8DC" BorderThickness="0" MinHeight="48" />
      <TextBlock Style="{StaticResource Section}" Text="진단 로그" />
      <ListBox x:Name="LogList" Height="120" FontFamily="Consolas" FontSize="11" Background="#15161A" Foreground="#C8C8CC" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <DockPanel x:Name="UpdatePanel" Margin="0,8,0,0">
      <Button x:Name="UpdateButton" DockPanel.Dock="Right" Margin="6,0,0,0" Visibility="Collapsed" Click="UpdateButton_Click" />
      <CheckBox x:Name="UpdateCheck" Content="원본 업데이트 확인" ToolTip="Ask GitHub for a new version at start and every 6 hours" Checked="UpdateCheck_Changed" Unchecked="UpdateCheck_Changed" />
    </DockPanel>
    <DockPanel Margin="0,8,0,0">
      <Button x:Name="ReportButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="진단 저장" ToolTip="화면과 진단 로그를 이 프로그램 폴더에 저장합니다." Click="ReportButton_Click" />
      <TextBlock x:Name="VersionText" Foreground="#6F7580" TextWrapping="Wrap" Text="버전" />
    </DockPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="블러드 러스트">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
          <TextBlock Text="수술 준비" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="포션, 수술 도구, 대상 배양 탱크를 함께 추천합니다." TextWrapping="Wrap" Foreground="#97A9BF" Margin="0,8,0,18" />
          <Border Background="#213B3C" BorderBrush="#398F83" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock Text="현재 추천" Foreground="#83E0C8" FontSize="12" />
              <TextBlock x:Name="VoraxMove" Text="수술 준비 화면 대기" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,8" />
              <TextBlock x:Name="VoraxDetail" Text="게임 로그와 화면을 연결하면 추천이 나타납니다." TextWrapping="Wrap" Foreground="#C4D4DE" />
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Section}" Text="계산 설정" />
          <TextBlock Text="인턴 의사 세라일 단계" Margin="0,0,0,6" />
          <ComboBox x:Name="ShelleyCombo" SelectionChanged="CompanionSetting_Changed">
            <ComboBoxItem Content="미보유 (추가 새로고침 0회)" />
            <ComboBoxItem Content="1단계 (추가 새로고침 0회)" />
            <ComboBoxItem Content="2단계 (추가 새로고침 1회)" />
            <ComboBoxItem Content="3단계 (추가 새로고침 1회)" />
            <ComboBoxItem Content="4단계 (추가 새로고침 2회)" />
            <ComboBoxItem Content="5단계 (추가 새로고침 2회)" />
            <ComboBoxItem Content="6단계 (추가 새로고침 2회)" />
          </ComboBox>
          <TextBlock Text="탐색 품질" Margin="0,14,0,6" />
          <ComboBox x:Name="VoraxQualityCombo" SelectionChanged="CompanionSetting_Changed">
            <ComboBoxItem Content="빠르게 / 선택지당 256회" /><ComboBoxItem Content="균형 / 선택지당 512회" /><ComboBoxItem Content="정밀 / 선택지당 1,024회" />
          </ComboBox>
          <TextBlock Text="CPU 사용" Margin="0,14,0,6" />
          <ComboBox x:Name="VoraxCpuCombo" SelectionChanged="CompanionSetting_Changed" />
          <TextBlock Text="최대 성능은 모든 CPU 스레드와 추가 OCR 재인식을 사용합니다." TextWrapping="Wrap" Foreground="#97A9BF" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="다시 인식" Click="VoraxSnap_Click" />
            <Button x:Name="VoraxToggle" Content="일시정지" Click="VoraxToggle_Click" />
            <Button Content="로그 선택" Click="VoraxLog_Click" />
          </StackPanel>
          <TextBlock x:Name="VoraxStatus" Text="대기" TextWrapping="Wrap" Foreground="#97A9BF" Margin="0,12,0,0" />
          <TextBlock Style="{StaticResource Section}" Text="표시 읽는 방법" />
          <TextBlock Text="밝은 테두리: 추천 카드와 배양 탱크.&#10;84만 달성률: 현재 상태에서 시뮬레이션한 결과이며 성공 보장은 아닙니다.&#10;11~13라운드 수술 플랜: 전투 난이도와 보상을 직접 판단합니다." TextWrapping="Wrap" LineHeight="23" />
          <TextBlock Style="{StaticResource Section}" Text="단축키" />
          <TextBlock Text="Ctrl+Alt+X  다시 인식&#10;Ctrl+Alt+V  오버레이 숨김 / 표시" Foreground="#C4D4DE" LineHeight="23" />
          <TextBlock Text="자동 인식에는 게임 설정의 로그 활성화가 필요합니다. 창 모드 또는 테두리 없는 창 모드를 사용하세요." TextWrapping="Wrap" Foreground="#97A9BF" Margin="0,20,0,0" />
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
