<Window x:Class="Tartarus.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="진단 저장" Width="460" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Malgun Gothic" FontSize="12" Background="#1E1F24" Foreground="#E8E8EC">
  <StackPanel Margin="12">
    <TextBlock x:Name="Prompt" Text="증상을 적어 주세요." Margin="0,0,0,6" TextWrapping="Wrap" />
    <TextBox x:Name="CommentBox" Height="120" PreviewKeyDown="CommentBox_PreviewKeyDown" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Background="#15161A" Foreground="#E8E8EC" BorderBrush="#3A3C44" CaretBrush="#E8E8EC" Padding="4" />
    <TextBlock Margin="0,8,0,0" Foreground="#9AA0AC" TextWrapping="Wrap"
               Text="게임 화면과 진단 로그를 프로그램의 user-data 폴더에 저장합니다. 공유할 때에는 저장된 내용을 먼저 확인하세요." />
    <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#E6B46E" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="SendButton" Content="저장" ToolTip="Shift+Enter" Padding="12,3" Margin="0,0,6,0" IsDefault="False" Click="SendButton_Click" />
      <Button x:Name="CancelButton" Content="취소" Padding="12,3" IsCancel="True" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</Window>
